# Copy to .env for a local run (node index.js reads it). Never commit .env.

# Gmail account that sends the mail, and a Gmail app password for it
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
EMAIL=
PASS=

# Email API v2. Generate the token with: openssl rand -base64 32
SENDER_TOKEN=
# Default recipient for v2 requests that do not name "to".
OWNER_EMAIL=
# Comma list of addresses a v2 request may name in "to". OWNER_EMAIL is
# always allowed. Defaults to OWNER_EMAIL alone.
ALLOWED_RECIPIENTS=

# Legacy body form {email, subject, message, pass1, pass2}. Leave both
# empty to turn the legacy form off.
PASS_1=
PASS_2=

# Optional: comma list of browser origins allowed to call the API.
# Leave empty for no CORS headers (server-side callers need none).
CORS_ORIGINS=

# Optional, local only: port, and proxy hops to trust for the client IP
# when running behind your own reverse proxy. Ignored on Vercel.
PORT=3000
TRUST_PROXY=
